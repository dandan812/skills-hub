{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Skills Hub Custom",
  "version": "0.9.1-custom.2",
  "identifier": "com.dandan812.skillshubcustom",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Skills Hub Custom",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 19
        },
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "resources/runtime-hooks/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/dandan812/skills-hub/releases/latest/download/updater.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIxOEQ5M0Q0ODVGRDdCNTQKUldSRWUvMkYxSk9OSVJrc2NWandmZEl0VzJWSTljWmdFWmRIL0c4dGV5eDMxN0FUMHJVaFVFZGwK"
    }
  }
}
